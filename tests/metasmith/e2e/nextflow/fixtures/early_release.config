// The process block mirrors src/metasmith/nextflow_config/local.nf: a task
// retries up to `tries`, then is IGNORED rather than failing the run. That is
// what makes "a dropped task must not hang a key" a production shape rather
// than a test artefact. The executor is sized so fast tasks never queue behind
// the deliberately slow one.

params {
    executor {
        cpus = 8
        queueSize = 16
    }
    process {
        tries = 2
    }
    recv_log = '/ws/recv.log'
    spec = [:]
    late_ms = 10000
    late_dir = '/ws/late'
    ref = ''
    meta = []
}

executor {
    cpus = params.executor.cpus
    queueSize = params.executor.queueSize
}

process {
    executor = 'local'
    cpus = 1
    cache = 'lenient'
    errorStrategy = {
        task.attempt < params.process.tries ? 'retry' : 'ignore'
    }
    maxRetries = params.process.tries + 2
    maxErrors = '-1'
}

trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
    raw = true
    fields = 'task_id,hash,process,tag,name,status,exit,attempt,error_action,submit,start,complete,duration'
}
