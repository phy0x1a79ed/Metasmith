/*
 * research/cami/nfcore/control.config -- the ONE pinned nf-core/mag 5.5.0 tool configuration
 * for both run 1 and run 2 of the CAMI fidelity comparison. Deliberately narrower than the
 * pipeline's defaults, which run every assembler against every binner (2 short-read
 * assemblers x 2 long-read assemblers x 5 binners): that is ten combinations per sample and
 * nobody's actual pipeline. This file pins exactly one.
 *
 * Every literal string and default value below was read from the pipeline's own source at
 * revision 56abab5b023ce953c9c43fe21090d156ad0e18af (the 5.5.0 tag), not from docs -- an
 * assembler or binner name outside the two literal lists nf-core/mag itself matches against
 * (workflows/mag.nf:206-207, subworkflows/local/binning/main.nf:36) is silently dropped from
 * binning with no error, and these params only ever reach those lists indirectly (they are
 * booleans; MEGAHIT/FLYE/etc. are the pipeline's own hard-coded meta.assembler strings, never
 * user-supplied).
 *
 * This file is inert unless it is actually handed to nextflow with `-c`: `-profile test`
 * merely supplies a small samplesheet and toy resource limits, it does not gate whether this
 * file is loaded, and it is not the thing this file "wins against". Nextflow always applies
 * every `-c` file after every `-profile`'s own includeConfig, regardless of the order the two
 * are written on the command line -- verified directly (research/cami/nfcore/run_test.sh
 * passes `-c fir.config -c control.config` after `-profile test,fir` and the resolved params
 * are this file's, not test.config's). So there was never a merge order to get right here;
 * the actual defect (fixed in this repair round) was that nothing invoked nextflow with this
 * file at all -- run_test.sh only ever passed fir.config.
 *
 *   short-read assembly : MEGAHIT only        (skip_spades, skip_spadeshybrid)
 *   long-read assembly   : Flye only           (skip_metamdbg)
 *   binning               : MetaBAT2, SemiBin2, COMEBin (skip_maxbin2, skip_concoct, skip_metabinner)
 *   refinement            : DAS Tool ON, and both its refined bins AND the three binners' raw
 *                           bins flow downstream (postbinning_input = 'both', available in this
 *                           version -- workflows/mag.nf:440). Both halves of turning refinement
 *                           on are separate params (refine_bins_dastool defaults false;
 *                           postbinning_input defaults "raw_bins_only") and BOTH must be set or
 *                           refinement silently runs but nothing downstream ever sees its output.
 *                           'refined_bins_only' was rejected: this campaign is a binner-fidelity
 *                           comparison against a three-binner arm, and under refined_bins_only
 *                           every downstream table (bin quality, GTDB-Tk, depths, contig2bin)
 *                           carries DAS Tool rows exclusively -- MetaBAT2/SemiBin2/COMEBin never
 *                           appear in a single output table. 'both' keeps every per-binner row
 *                           alongside the refined set, tagged by `meta.refinement`
 *                           (unrefined/unrefined_unbinned vs DAS Tool's own tag) so the two are
 *                           still distinguishable downstream.
 *   bin quality           : CheckM2, not the default BUSCO (run_busco, run_checkm2)
 *   mapping mode           : own -- see the binning_map_mode note below.
 *   taxonomy              : disabled (skip_gtdbtk) -- the metasmith side of this comparison
 *                           dropped GTDB-Tk classification too, so scoring it on only one arm
 *                           would be worse than dropping it on both. See skip_gtdbtk below.
 *
 * A failed or empty DAS Tool, COMEBin or CheckM2 run must not silently empty its downstream
 * tables. conf/base.config gives all three `errorStrategy = ... task.exitStatus == 1 ?
 * 'ignore' : ...` (DASTOOL_DASTOOL, CHECKM2_PREDICT) or `[1, 255] ? 'ignore' : ...`
 * (COMEBIN_RUNCOMEBIN) -- exit 1 is each tool's own "ran cleanly, found nothing" code (per
 * base.config's own comments: CheckM2 on a Diamond miss, DAS Tool when it can't call an
 * ensemble bin set), and under postbinning_input = 'both' an ignored DAS Tool would silently
 * drop only the refined half rather than the whole run. The three withName overrides below
 * replace 'ignore' with 'finish' for exactly that exit code, so a run that would have reported
 * `completed` with an empty refined-bin set now fails instead. Verified against a synthetic
 * process (not nf-core/mag itself, which never fails DAS Tool/CheckM2/COMEBin against the tiny
 * `-profile test` data): a `-c` override of the same withName selector, same exit-code branch,
 * does take effect over conf/base.config's own withName block and does turn a would-be-ignored
 * exit 1 into a failed run (NXF_EXIT=1, "Error executing process").
 *
 * checkm2_db and gtdb_db are staging facts (which cluster path holds the pre-fetched database)
 * rather than tool choices, so they live in fir.config beside the rest of fir's filesystem
 * layout -- not here. See fir.config for the paths and the taxonomy-routing decision.
 */
params {
    // -- Assembly: MEGAHIT (short reads), Flye (long reads) --
    skip_spades       = true   // SPAdes off
    skip_spadeshybrid = true   // SPAdesHybrid off
    skip_megahit      = false  // MEGAHIT on (pipeline default; stated for the record)
    skip_flye         = false  // Flye on (pipeline default; stated for the record)
    skip_metamdbg     = true   // MetaMDBG off

    // -- Binning: MetaBAT2, SemiBin2, COMEBin --
    skip_metabat2   = false  // on (pipeline default; stated for the record)
    skip_semibin    = false  // on (pipeline default; stated for the record)
    skip_comebin    = false  // on -- the pipeline's own -profile test flips this to true; that
                              // only matters at all once this file is actually loaded (see the
                              // header comment -- it wasn't, until this repair round).
    skip_maxbin2    = true
    skip_concoct    = true
    skip_metabinner = true

    // -- Mapping mode for co-abundance binning inputs: own-assembly only, not group cross
    // product. samples.tsv's `dataset` column became this sheet's `group` column so nf-core/mag
    // would recognise each CAMI dataset as a cohort, but binning_map_mode's default ('group')
    // reads that column as an instruction to cross-map every sample's reads against every other
    // sample's assembly *within* the group -- a sum-of-squares over group size
    // (subworkflows/local/binning_preparation_shortread), not a linear cost. samples.tsv's
    // `strain` group alone has 100 samples: 'group' costs 14,183 alignment tasks total (10,000
    // from `strain` alone) against 229 under 'own'. This comparison is per-sample MAG recovery
    // against CAMI's per-sample gold standard, not a co-abundance study of the six datasets'
    // time series, so the cross-mapping signal 'group' buys isn't a signal this campaign scores
    // -- 'own' maps each sample only against its own assembly, matching the granularity the
    // ground truth is actually keyed on, at 1/62nd the alignment task count.
    binning_map_mode = 'own'

    // -- Refinement: DAS Tool ON, both raw and refined bins continue downstream --
    refine_bins_dastool = true
    postbinning_input   = 'both'

    // -- Bin quality: CheckM2 in place of BUSCO --
    skip_binqc  = false
    run_busco   = false
    run_checkm  = false
    run_checkm2 = true

    // -- Taxonomy: disabled outright. skip_gtdbtk defaults false and a bare gtdb_db default is
    // a live 110 GB URL that mag.nf resolves eagerly on the driver (see fir.config's header for
    // the network-fetch mechanics and the reference already staged at
    // /scratch/phyberos/staging/gtdb/release232). Routing to that staged tree was this file's
    // first answer; reversed once the campaign lead confirmed the metasmith side of this
    // comparison is also dropping GTDB-Tk classification from what it scores. Running a real
    // classification here would cost real compute (pplacer placement into a populated tree,
    // not the pipeline's toy mockup) for a taxonomy nothing compares against -- keeping it on
    // one arm only would be worse than dropping it on both.
    skip_gtdbtk = true

    // -- An ignored (empty) DAS Tool/COMEBin/CheckM2 must fail the run, not empty its tables.
    // See the header comment: this replaces conf/base.config's `... exitStatus == 1 ? 'ignore'
    // : ...` (or `[1, 255] ? 'ignore' : ...`) branch with 'finish' for exactly the exit codes
    // those tools use to report "ran cleanly, produced nothing", while leaving the retry
    // branches for genuine infra failures (OOM, preemption, ...) untouched.
}
process {
    withName: DASTOOL_DASTOOL {
        errorStrategy = { task.exitStatus in ((130..145) + [104, 175]) ? 'retry' : 'finish' }
    }
    withName: CHECKM2_PREDICT {
        errorStrategy = { task.exitStatus in ((130..145) + [104, 175]) ? 'retry' : 'finish' }
    }
    withName: COMEBIN_RUNCOMEBIN {
        errorStrategy = { task.exitStatus in [1, 255] ? 'finish' : 'retry' }
    }
}
