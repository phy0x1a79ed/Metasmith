/*
 * E1ctl long arm: depth as E1's scored long MetaBAT2 took it (b19_long_rerun.sbatch),
 * identity 80 on the metabat2 2.17 image.
 *
 * CAUTION assembly_input accepts only `Flye`, and nf-core/mag 5.5.0 routes a long-read
 * assembly to the long-read depth process by the case-sensitive `meta.assembler in ['FLYE',
 * 'METAMDBG']` (subworkflows/local/binning/main.nf:36). Every assembly in this arm therefore
 * takes the SHORTREAD depth process, so that is the one configured here.
 */
process {
    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS_SHORTREAD {
        container = 'quay.io/biocontainers/metabat2:2.17--hd498684_0'
        ext.args  = '--percentIdentity 80'
    }
    withName: METABAT2_JGISUMMARIZEBAMCONTIGDEPTHS_LONGREAD {
        container = 'quay.io/biocontainers/metabat2:2.17--hd498684_0'
        ext.args  = '--percentIdentity 80'
    }
}
